---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import MapHotspot from "../components/MapHotspot.tsx";
import KleapForm from "../components/KleapForm";

const dynasties = [
  { era: "Khai Quốc", desc: "Phạn Thị lập quốc, dẹp loạn 100 năm, mở ra triều đại đầu tiên.", year: "Tiền Phạn" },
  { era: "Trung Cổ", desc: "Bốn đời Hoàng đế trị vì, xây dựng Vạn Lý Trường Thành phía Bắc.", year: "Phạn Nguyên" },
  { era: "Cực Thịnh", desc: "Văn – Võ cùng hưng thịnh, kinh tế phồn hoa. Bắt đầu xuất hiện dấu hiệu suy thoái.", year: "Huyền Khang" },
  { era: "Huyền Minh", desc: "Đương kim Hoàng đế. Long thể suy nhược, chưa lập Thái tử. Càn Thanh Điện bắt đầu chao đảo.", year: "Năm thứ 32" }
];

const meaning = [
  { han: "梵", viet: "Phạn", meaning: "Sự thanh tĩnh, thần thánh nhưng cũng mang sắc thái huyền bí. Tượng trưng cho sức mạnh tâm linh ẩn sau triều đại." },
  { han: "玄", viet: "Huyền", meaning: "Màn đêm, sự bí ẩn, những âm mưu thao túng từ bóng tối. Đây là mảng giang hồ, sát thủ, gián điệp." },
  { han: "霄", viet: "Tiêu", meaning: "Chín tầng mây, đỉnh cao quyền lực. Tượng trưng cho Hoàng thất và ngai vàng — đích đến cuối cùng." }
];
---

<Base
  title="Cốt Truyện · Phạn Huyền Tiêu — Đại Phạn Quốc"
  description="Bối cảnh Đại Phạn Quốc và ý nghĩa tên gọi Phạn – Huyền – Tiêu. Khám phá lịch sử triều đại, các địa danh chính và bản đồ Hoàng Thành tương tác."
>
  <Header />

  <main class="bg-background text-foreground">
    <!-- HERO -->
    <section class="relative h-[60vh] min-h-[420px] overflow-hidden">
      <img src="https://assets.kleap.io/102911/images/1790162702124-hero-palace-night" alt="Hoàng cung đêm" class="absolute inset-0 w-full h-full object-cover" />
      <div class="absolute inset-0 bg-gradient-to-b from-black/30 via-black/40 to-background"></div>
      <div class="relative h-full max-w-5xl mx-auto px-6 flex flex-col justify-end pb-16 text-primary-foreground">
        <p class="text-xs tracking-[0.4em] uppercase opacity-80 mb-3">Chương I — Thế Giới</p>
        <h1 class="font-serif text-5xl md:text-7xl font-semibold leading-tight mb-4">Cốt Truyện<br/><span class="text-accent">Đại Phạn Quốc</span></h1>
        <p class="text-lg max-w-2xl opacity-90 leading-relaxed">
          Một triều đại giả tưởng đang ở đỉnh cực thịnh — nhưng bên trong, bóng tối đã bắt đầu nuốt chửng ánh sáng Càn Thanh Điện.
        </p>
      </div>
    </section>

    <!-- Ý NGHĨA TÊN GỌI -->
    <section class="py-20 md:py-28">
      <div class="max-w-6xl mx-auto px-6">
        <p class="text-xs tracking-[0.4em] text-accent uppercase mb-3 text-center">Ba chữ Hán</p>
        <h2 class="font-serif text-4xl md:text-5xl font-semibold text-center mb-16">
          <span class="text-primary">Phạn</span> · <span class="text-primary">Huyền</span> · <span class="text-primary">Tiêu</span>
        </h2>
        <div class="grid md:grid-cols-3 gap-6">
          {meaning.map((m) => (
            <div class="bg-card border border-border rounded p-8 hover:border-primary hover:-translate-y-1 transition">
              <div class="text-6xl font-serif text-accent mb-4">{m.han}</div>
              <div class="text-xs tracking-widest text-muted-foreground uppercase mb-1">{m.viet}</div>
              <p class="text-foreground/90 leading-relaxed">{m.meaning}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- LỊCH SỬ -->
    <section class="py-20 md:py-28 bg-card border-y border-border">
      <div class="max-w-5xl mx-auto px-6">
        <p class="text-xs tracking-[0.4em] text-accent uppercase mb-3 text-center">Niên biểu triều đại</p>
        <h2 class="font-serif text-4xl md:text-5xl font-semibold text-center mb-16">Bốn Thời Kỳ</h2>
        <div class="space-y-8">
          {dynasties.map((d, i) => (
            <div class="grid md:grid-cols-12 gap-6 items-start group">
              <div class="md:col-span-2 font-serif text-5xl font-bold text-accent leading-none tabular-nums">
                {String(i + 1).padStart(2, "0")}
              </div>
              <div class="md:col-span-3">
                <div class="font-serif text-xl font-semibold text-primary">{d.era}</div>
                <div class="text-xs tracking-widest text-muted-foreground uppercase mt-1">{d.year}</div>
              </div>
              <div class="md:col-span-7 border-l-2 border-accent pl-6 group-hover:border-primary transition">
                <p class="text-foreground/90 leading-relaxed">{d.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- BẢN ĐỒ HOÀNG THÀNH -->
    <section class="py-20 md:py-28">
      <div class="max-w-6xl mx-auto px-6">
        <p class="text-xs tracking-[0.4em] text-accent uppercase mb-3 text-center">Địa danh chính</p>
        <h2 class="font-serif text-4xl md:text-5xl font-semibold text-center mb-4">Bản Đồ Hoàng Thành</h2>
        <p class="text-center text-muted-foreground mb-12 max-w-2xl mx-auto">
          Rê chuột vào từng điểm để xem không khí và sự kiện IC đang diễn ra tại các địa danh trong truyện.
        </p>
        <MapHotspot client:visible />
      </div>
    </section>

    <!-- DẪN DẮT CỐT TRUYỆN -->
    <section class="py-20 md:py-28 bg-primary text-primary-foreground relative overflow-hidden">
      <div class="absolute inset-0 opacity-20">
        <img src="https://assets.kleap.io/102911/images/1790162702194-can-thanh-dien" alt="Càn Thanh Điện" class="w-full h-full object-cover" />
      </div>
      <div class="relative max-w-4xl mx-auto px-6 text-center">
        <p class="font-serif text-2xl md:text-3xl leading-relaxed italic">
          "Hoàng đế đương nhiệm niên hiệu <strong>Huyền Minh</strong> tuổi đã cao, long thể ngày một suy nhược nhưng chưa chính thức lập Thái tử. Chốn hậu cung, các thế lực Phi tần hậu thuẫn cho các Hoàng tử tranh giành sủng ái và vị trí Chữ Quân. Ngoài triều đình, Văn quan - Võ tướng chia rẽ thành nhiều phe phái. Cùng lúc đó, các thị tộc giang hồ và giáo phái bí mật rục rịch thâm nhập vào kinh thành nhằm thao túng quyền lực từ bóng tối."
        </p>
        <p class="mt-8 text-sm tracking-widest uppercase opacity-70">— Trích Biên Niên Sử · Hồi Thứ Nhất</p>
      </div>
    </section>

    <!-- FORM ĐÓNG GÓP LORE -->
    <section class="py-20 md:py-28">
      <div class="max-w-3xl mx-auto px-6">
        <p class="text-xs tracking-[0.4em] text-accent uppercase mb-3 text-center">Đóng góp</p>
        <h2 class="font-serif text-3xl md:text-4xl font-semibold text-center mb-4">Đề Xuất Bối Cảnh Mới</h2>
        <p class="text-center text-muted-foreground mb-10">
          Bạn có ý tưởng địa danh, sự kiện lịch sử, hoặc chi tiết bối cảnh? Gửi cho Ban Quản Lý duyệt.
        </p>
        <KleapForm
          client:load
          formId="lore-submit"
          title="Đề Xuất Lore"
          fields={[
            { name: "player", label: "Tên Player", type: "text", required: true },
            { name: "title", label: "Tên địa danh / sự kiện", type: "text", required: true },
            { name: "category", label: "Loại", type: "text", required: false },
            { name: "description", label: "Mô tả chi tiết", type: "textarea", required: true }
          ]}
          submitText="Gửi Đề Xuất"
        />
      </div>
    </section>
  </main>

  <Footer />
</Base>
