  <!-- ============ SCRIPTS ============ -->
  <script is:inline>
    // ---- Theme toggle (Day = Triều Đình / Night = Huyền Tiêu) ----
    (function() {
      try {
        var stored = localStorage.getItem('pht-theme');
        if (stored === 'dark') document.documentElement.classList.add('dark');
        if (stored === 'light') document.documentElement.classList.remove('dark');
      } catch(e) {}
    })();
    document.addEventListener('astro:page-load', function() {
      var tt = document.getElementById('theme-toggle');
      if (tt && !tt.dataset.bound) {
        tt.dataset.bound = '1';
        tt.addEventListener('click', function() {
          document.documentElement.classList.toggle('dark');
          try { localStorage.setItem('pht-theme', document.documentElement.classList.contains('dark') ? 'dark' : 'light'); } catch(e) {}
        });
      }

      // ---- Quotes carousel ----
      var track = document.getElementById('quote-slides');
      var dots = document.querySelectorAll('.quote-dot');
      if (track && dots.length && !track.dataset.bound) {
        track.dataset.bound = '1';
        var idx = 0;
        var total = dots.length;
        function go(n) {
          idx = (n + total) % total;
          track.style.transform = 'translateX(-' + (idx * 100) + '%)';
          dots.forEach(function(d, i) {
            d.classList.toggle('bg-primary', i === idx);
            d.classList.toggle('bg-[var(--border)]', i !== idx);
          });
        }
        dots.forEach(function(d, i) { d.addEventListener('click', function() { go(i); }); });
        setInterval(function() { go(idx + 1); }, 6000);
      }

      // ---- Power balance re-roll ----
      var reroll = document.getElementById('reroll-balance');
      if (reroll && !reroll.dataset.bound) {
        reroll.dataset.bound = '1';
        reroll.addEventListener('click', function() {
          var rows = document.querySelectorAll('.balance-row');
          var a = 30 + Math.floor(Math.random() * 30);
          var b = 30 + Math.floor(Math.random() * 30);
          var c = 100 - a - b;
          var vals = [a, b, c];
          rows.forEach(function(r, i) {
            var v = vals[i];
            r.querySelector('.balance-bar').style.width = v + '%';
            r.querySelector('.balance-pct').textContent = v + '%';
          });
        });
      }

      // ---- Fortune generator ----
      var fortunes = [
        { q: 'Quẻ Càn', hex: '☰', text: 'Hôm nay kẻ ngay hướng về ngươi, kẻ gian tránh xa. Giữ lòng sáng, mọi sự an.' },
        { q: 'Quẻ Khôn', hex: '☷', text: 'Cõi lòng mềm như đất, nhưng bước chân vững như núi. Nhẫn là nước cờ cao nhất.' },
        { q: 'Quẻ Chấn', hex: '☳', text: 'Sấm động bất ngờ. Có hung tin từ phương Bắc. Đừng vội hành động, hãy lắng nghe.' },
        { q: 'Quẻ Tốn', hex: '☴', text: 'Gió thổi đâu, ngươi theo đó. Hôm nay là ngày thuận lợi cho hôn nhân và giao kết.' },
        { q: 'Quẻ Khảm', hex: '☵', text: 'Nước sâu khó đo. Đừng tin lời đường mật — bên dưới là vực thẳm.' },
        { q: 'Quẻ Ly', hex: '☲', text: 'Lửa bùng cháy. Danh tiếng ngươi lan xa. Nhưng cẩn thận ánh lửa soi rõ cả sự xấu.' },
        { q: 'Quẻ Cấn', hex: '☶', text: 'Núi đứng yên. Hôm nay không nên dời chân. Kẻ đến sẽ đến, kẻ đi sẽ đi.' },
        { q: 'Quẻ Đoài', hex: '☱', text: 'Đầm nước vui. Hôm nay vui chuyện cũ, gặp lại cố nhân, lòng dịu lại.' }
      ];
      var fbox = document.getElementById('fortune-box');
      var fbtn = document.getElementById('fortune-btn');
      if (fbtn && fbox && !fbtn.dataset.bound) {
        fbtn.dataset.bound = '1';
        fbtn.addEventListener('click', function() {
          var f = fortunes[Math.floor(Math.random() * fortunes.length)];
          fbox.innerHTML = '<div class="text-center w-full">' +
            '<div class="text-6xl font-serif text-accent mb-3">' + f.hex + '</div>' +
            '<div class="text-xl font-serif font-semibold mb-3">' + f.q + '</div>' +
            '<p class="text-base text-foreground/85 italic max-w-xl mx-auto leading-relaxed">' + f.text + '</p>' +
            '</div>';
          fbox.classList.add('pulse-soft');
          setTimeout(function() { fbox.classList.remove('pulse-soft'); }, 1200);
        });
      }

      // ---- Music toggle (placeholder — no audio file, just UI state) ----
      var mt = document.getElementById('music-toggle');
      if (mt && !mt.dataset.bound) {
        mt.dataset.bound = '1';
        mt.addEventListener('click', function() {
          var on = mt.classList.toggle('is-playing');
          var onIcon = document.getElementById('icon-music-on');
          var offIcon = document.getElementById('icon-music-off');
          if (on) { onIcon.classList.remove('hidden'); offIcon.classList.add('hidden'); }
          else { onIcon.classList.add('hidden'); offIcon.classList.remove('hidden'); }
        });
      }

      // ---- Cursor ink dots (lightweight trail) ----
      if (!window.__phtInkBound) {
        window.__phtInkBound = true;
        var last = 0;
        document.addEventListener('mousemove', function(e) {
          var now = Date.now();
          if (now - last < 60) return;
          last = now;
          var d = document.createElement('div');
          d.className = 'ink-dot';
          d.style.left = e.clientX + 'px';
          d.style.top = e.clientY + 'px';
          document.body.appendChild(d);
          requestAnimationFrame(function() {
            d.style.opacity = '0.7';
            d.style.transform = 'translate(-50%, -50%) scale(2.5)';
          });
          setTimeout(function() { d.style.opacity = '0'; }, 30);
          setTimeout(function() { if (d.parentNode) d.parentNode.removeChild(d); }, 900);
        });
      }
    });
  </script>
</Base>
