          scope.querySelectorAll("a[href]").forEach(function (a) {
            var label = (a.textContent || "").replace(/\s+/g, " ").trim();
            if (!label || label.length < 2) return;
            if (a.querySelector("img, svg") && label.length < 3) return; // logo
            var r = a.getBoundingClientRect();
            if (a.offsetParent !== null && r.width > 0 && r.left < window.innerWidth) n++;
          });
          return n;
        }
        // 🛑 HANDS OFF a site that already has its own working mobile menu.
        // Helping there does not ADD a menu, it REPLACES a working one: the
        // handler below calls preventDefault(), and on a <label for> that is
        // precisely what stops the checkbox from toggling — so the site's own
        // drawer never opens and ours does, in white, over their design, out of
        // any file they can edit. Reported verbatim by the owner of
        // rhonyscar.fr: "impossible de supprimer la navbar coulissante
        // blanche". Only CSS-only disclosures are detected, because those are
        // the ones the DOM proves complete: a <label for> pointing at a real
        // checkbox, or a `peer-checked:` class (Tailwind only emits that rule
        // if the class is there). A bare aria-expanded is NOT evidence — the
        // model decorates icons with it and wires nothing, which is the exact
        // dead menu this whole block exists to rescue.
        function siteOwnsMenu() {
          var scopes = document.querySelectorAll("header, nav");
          for (var i = 0; i < scopes.length; i++) {
            var s = scopes[i];
            // A <details> proves itself: the browser toggles it, no CSS needed.
            if (s.querySelector("details > summary")) return true;
            // 🚨 A `peer-checked:` class is NOT proof on its own. Tailwind
            // compiles it to `.peer:checked ~ …`, so the rule only EXISTS if
            // some element actually carries `peer`. Measured on app 88583
            // (zee-news.kleap.io): the checkbox is `class="hidden"` with no
            // `peer` anywhere, Tailwind emitted ZERO matching rules
            // (`cssRules matching /peer.*checked/ → []`), and forcing
            // `checked = true` leaves the drawer at display:none — that menu has
            // never opened. Its header shows 2 links on mobile against 19 in the
            // drawer, so OUR rescue is its only navigation. Requiring the wired
            // sibling keeps us rescuing it while still standing off the sites
            // that really do own a menu.
            if (s.querySelector('.peer ~ [class*="peer-checked:"]')) return true;
            var labels = s.querySelectorAll("label[for]");
            for (var j = 0; j < labels.length; j++) {
              var ctl = document.getElementById(labels[j].getAttribute("for"));
              // Same reason for the label branch: 88583 trips it too (real
              // label → real checkbox), so the control must be a wired `peer`.
              if (
                ctl &&
                (ctl.type === "checkbox" || ctl.type === "radio") &&
                ctl.classList.contains("peer")
              )
                return true;
            }
          }
          return false;
        }
        function setup() {
          if (siteOwnsMenu()) return;
          var scope = navScope();
          if (!scope) return;
          var links = collectLinks(scope);
          if (links.length < 2) return; // nothing to put in a menu
          if (visibleNavCount(scope) >= links.length) return; // ALL links already inline → no menu needed
          if (!ensureDrawer()) return;
          var burgers = findHamburger();
          if (!burgers.length) {
            var existing = document.getElementById("kleap-burger");
            if (!existing) injectHamburger();
            burgers = [document.getElementById("kleap-burger")].filter(Boolean);
          }
          burgers.forEach(function (trig) {
            if (!trig || trig.__kmWired) return;
            trig.__kmWired = true;
            trig.style.cursor = "pointer";
            trig.addEventListener("click", function (e) {
              e.preventDefault();
              e.stopPropagation();
              openMenu();
            });
          });
        }
        document.addEventListener("keydown", function (e) {
          if (e.key === "Escape") closeMenu();
        });
        document.addEventListener("DOMContentLoaded", setup);
        document.addEventListener("astro:page-load", setup);
        if (document.readyState !== "loading") setup();
      })();
    </script>

